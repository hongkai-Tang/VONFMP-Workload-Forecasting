{
  "schema_version": 1,
  "project_root": "..",
  "portable_dataset_path": "inputs/alibaba_selected_200/dataset.npz",
  "time_axis": {
    "resample_seconds": 60,
    "start_seconds": 86400,
    "end_seconds_exclusive": 777600
  },
  "split": {
    "train_ratio": 0.60,
    "validation_ratio": 0.20,
    "test_ratio": 0.20
  },
  "grid": {
    "history_lengths": [1440],
    "forecast_horizons": [1]
  },
  "protocol": {
    "experiment_name": "Alibaba Ours KPR lambda tau sensitivity seed27",
    "forecast_strategy": "direct_multi_step",
    "seed": 27,
    "num_states": 8,
    "max_order": 3,
    "time_decay": 0.02,
    "time_decay_per_minute": 0.02,
    "message_passing_steps": 2,
    "einstein_strength": 0.5,
    "backoff_blend": 0.5,
    "time_period_steps": 1440,
    "prototype_length": 30,
    "message_hidden_dim": 8,
    "transition_hidden_dim": 32,
    "membership_definition": "single_time_bucket_resource_vector",
    "prediction_feedback": false
  },
  "spatial": {
    "link_mode": "topology_only"
  },
  "training": {
    "epochs": 20,
    "learning_rate": 0.003,
    "weight_decay": 0.0001,
    "gradient_clip": 5.0,
    "max_origins_per_epoch": 128,
    "early_stopping_patience": 5,
    "dynamic_loss_weight": 0.25,
    "adaptive_order_loss_weight": 0.25,
    "device": "cuda"
  },
  "runtime": {
    "progress_interval_seconds": 30,
    "recursive_checkpoint_interval_h": 1,
    "audit_workloads": 20,
    "audit_origins_per_split": 2,
    "bootstrap_samples": 1000
  },
  "missing": {
    "max_causal_fill_steps": 3,
    "min_history_coverage": 0.80
  },
  "selection": {
    "max_workloads": 200,
    "strategy": "valid_row_count",
    "require_exact_count": true
  },
  "origins": {
    "splits": ["validation", "test"],
    "stride_steps": 60,
    "include_boundary_origin": true,
    "require_all_forecast_targets_observed": false
  },
  "source_priority": ["portable_schema"],
  "sources": {
    "portable_schema": {
      "format": "csv",
      "path": "inputs/alibaba_selected_200/source_schema.csv",
      "has_header": true,
      "columns": [],
      "workload_column": "workload_id",
      "node_column": "node_id",
      "time_column": "time_seconds",
      "time_unit": "seconds",
      "delimiter": ",",
      "resources": [
        {"name": "cpu", "column": "cpu_observed", "scale": 1.0, "valid_min": 0.0, "valid_max": null},
        {"name": "mem", "column": "mem_observed", "scale": 1.0, "valid_min": 0.0, "valid_max": null},
        {"name": "disk_i", "column": "disk_i_observed", "scale": 1.0, "valid_min": 0.0, "valid_max": 1.0},
        {"name": "disk_o", "column": "disk_o_observed", "scale": 1.0, "valid_min": 0.0, "valid_max": 1.0}
      ]
    }
  },
  "deployment_priority": ["portable_deployment"],
  "deployment_sources": {
    "portable_deployment": {
      "format": "csv",
      "path": "inputs/alibaba_selected_200/selected_workloads.csv",
      "required_columns": ["workload_id", "node_id"],
      "workload_column": "workload_id",
      "node_column": "node_id",
      "has_header": true,
      "delimiter": ","
    }
  },
  "sensitivity_suite": {
    "baseline": {
      "num_states": 8,
      "max_order": 3,
      "message_passing_steps": 2,
      "time_decay_per_minute": 0.02,
      "granularity_seconds": 60,
      "history_duration_seconds": 86400,
      "forecast_horizon_steps": 1
    },
    "studies": {
      "k": {"values": [4, 6, 8, 10, 12]},
      "p": {"values": [1, 3, 5, 10, 15]},
      "r": {"values": [1, 2, 3, 4]},
      "lambda": {"values": [0.0, 0.005, 0.01, 0.02, 0.05, 0.10]},
      "tau": {"seconds": [60, 1800, 3600, 7200]}
    },
    "fixed_k": true,
    "automatic_coverage_selection": false,
    "repeat_count": 1,
    "minimum_resample_bucket_coverage": 0.80,
    "execution": {
      "seed": 27,
      "device": "cuda",
      "target_gpu": "NVIDIA Quadro P2200",
      "mode": "sequential_resume_safe"
    }
  },
  "output_dir": "runs"
}
