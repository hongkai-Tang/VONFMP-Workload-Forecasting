{
  "schema_version": 1,
  "project_root": "../../..",
  "time_axis": {
    "resample_seconds": 60,
    "start_seconds": 86400,
    "end_seconds_exclusive": 777600
  },
  "split": {
    "train_ratio": 0.60,
    "validation_ratio": 0.20,
    "test_ratio": 0.20
  },
  "grid": {
    "history_lengths": [5, 15, 30, 60, 180, 360, 720, 1440],
    "forecast_horizons": [1, 5, 15, 30, 60, 180, 360, 600, 720, 1440, 1728]
  },
  "protocol": {
    "experiment_name": "Alibaba Ours-TopologyOnly Lxh recursive experiment",
    "forecast_strategy": "recursive",
    "seed": 7,
    "num_states": 8,
    "max_order": 3,
    "time_decay": 0.02,
    "message_passing_steps": 2,
    "einstein_strength": 0.5,
    "backoff_blend": 0.5,
    "time_period_steps": 1440,
    "prototype_length": 30,
    "message_hidden_dim": 8,
    "transition_hidden_dim": 32
  },
  "spatial": {
    "link_mode": "topology_only"
  },
  "training": {
    "epochs": 20,
    "learning_rate": 0.003,
    "weight_decay": 0.0001,
    "gradient_clip": 5.0,
    "max_origins_per_epoch": 128,
    "early_stopping_patience": 5,
    "dynamic_loss_weight": 0.25,
    "adaptive_order_loss_weight": 0.25,
    "device": "cpu"
  },
  "runtime": {
    "progress_interval_seconds": 30,
    "recursive_checkpoint_interval_h": 60,
    "audit_workloads": 20,
    "audit_origins_per_split": 2,
    "bootstrap_samples": 1000
  },
  "missing": {
    "max_causal_fill_steps": 3,
    "min_history_coverage": 0.80
  },
  "selection": {
    "max_workloads": 200,
    "strategy": "seeded_metadata_candidates",
    "candidate_pool_size": 400,
    "candidate_metadata_path": "data/alibaba_v2018/raw/container_meta.tar.gz",
    "require_exact_count": true
  },
  "origins": {
    "splits": ["validation", "test"],
    "stride_steps": 60,
    "include_boundary_origin": true,
    "require_all_forecast_targets_observed": false
  },
  "source_priority": ["raw_csv", "prepared_parquet", "prepared_csv"],
  "sources": {
    "prepared_csv": {
      "format": "csv",
      "path": "data/alibaba_v2018/processed/resources.csv",
      "has_header": true,
      "columns": [],
      "workload_column": "workload_id",
      "node_column": null,
      "time_column": "time",
      "time_unit": "bucket",
      "delimiter": ",",
      "resources": [
        {"name": "cpu", "column": "cpu", "scale": 1.0, "valid_min": 0.0, "valid_max": null},
        {"name": "mem", "column": "mem", "scale": 1.0, "valid_min": 0.0, "valid_max": null},
        {"name": "disk_i", "column": "disk_i", "scale": 1.0, "valid_min": 0.0, "valid_max": 1.0},
        {"name": "disk_o", "column": "disk_o", "scale": 1.0, "valid_min": 0.0, "valid_max": 1.0}
      ]
    },
    "prepared_parquet": {
      "format": "parquet",
      "path": "data/alibaba_v2018/processed/resources.parquet",
      "has_header": true,
      "columns": [],
      "workload_column": "workload_id",
      "node_column": null,
      "time_column": "time",
      "time_unit": "bucket",
      "delimiter": ",",
      "resources": [
        {"name": "cpu", "column": "cpu", "scale": 1.0, "valid_min": 0.0, "valid_max": null},
        {"name": "mem", "column": "mem", "scale": 1.0, "valid_min": 0.0, "valid_max": null},
        {"name": "disk_i", "column": "disk_i", "scale": 1.0, "valid_min": 0.0, "valid_max": 1.0},
        {"name": "disk_o", "column": "disk_o", "scale": 1.0, "valid_min": 0.0, "valid_max": 1.0}
      ]
    },
    "raw_csv": {
      "format": "csv",
      "path": "data/alibaba_v2018/raw/container_usage.csv",
      "has_header": false,
      "columns": [
        "container_id",
        "machine_id",
        "time_stamp",
        "cpu_util_percent",
        "mem_util_percent",
        "cpi",
        "mem_gps",
        "mpki",
        "net_in",
        "net_out",
        "disk_io_percent"
      ],
      "workload_column": "container_id",
      "node_column": "machine_id",
      "time_column": "time_stamp",
      "time_unit": "seconds",
      "delimiter": ",",
      "resources": [
        {"name": "cpu", "column": "cpu_util_percent", "scale": 0.01, "valid_min": 0.0, "valid_max": null},
        {"name": "mem", "column": "mem_util_percent", "scale": 0.01, "valid_min": 0.0, "valid_max": null},
        {"name": "disk_i", "column": "disk_io_percent", "scale": 0.005, "valid_min": 0.0, "valid_max": 100.0},
        {"name": "disk_o", "column": "disk_io_percent", "scale": 0.005, "valid_min": 0.0, "valid_max": 100.0}
      ]
    }
  },
  "deployment_priority": ["csv", "parquet"],
  "deployment_sources": {
    "csv": {
      "format": "csv",
      "path": "data/alibaba_v2018/processed/deployment.csv",
      "required_columns": ["workload_id", "node_id"],
      "workload_column": "workload_id",
      "node_column": "node_id",
      "has_header": true,
      "delimiter": ","
    },
    "parquet": {
      "format": "parquet",
      "path": "data/alibaba_v2018/processed/deployment.parquet",
      "required_columns": ["workload_id", "node_id"],
      "workload_column": "workload_id",
      "node_column": "node_id",
      "has_header": true,
      "delimiter": ","
    }
  },
  "output_dir": "experiments/alibaba_ours_lh_recursive/runs"
}
